---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const rinconEntries = await getCollection('rincon');
const sortedRincon = rinconEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const typeBadgeMap: Record<string, string> = {
  proyecto: 'text-syntax-accent border-syntax-accent/40 bg-syntax-accent/10',
  tcg: 'text-syntax-warning border-syntax-warning/40 bg-syntax-warning/10',
  gaming: 'text-syntax-info border-syntax-info/40 bg-syntax-info/10',
  coleccion: 'text-purple-400 border-purple-500/40 bg-purple-500/10',
  setup: 'text-emerald-400 border-emerald-500/40 bg-emerald-500/10',
  general: 'text-syntax-subtle border-syntax-subtle/40 bg-carbon-800',
};
---

<BaseLayout title="El Rincón" currentPath="/rincon">
  <section class="mb-8 pb-5 border-b border-carbon-700/60">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs font-mono text-syntax-accent font-semibold">[EL RINCÓN // PERSONAL]</span>
      <span class="text-xs font-mono text-syntax-muted">/root/rincon</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-syntax-text">
      Proyectos personales, Pokémon TCG y pasatiempos
    </h1>
    <p class="mt-2 text-sm text-syntax-muted max-w-2xl font-normal leading-relaxed">
      Un rincón para compartir aficiones: cartas coleccionables, sesiones de gaming casual, consolas y scripts o herramientas que programo por diversión.
    </p>
  </section>

  <div class="space-y-4">
    {sortedRincon.map(async (item) => {
      const { Content } = await item.render();
      const formattedDate = item.data.date.toISOString().split('T')[0];
      const badgeStyle = typeBadgeMap[item.data.type] || typeBadgeMap.general;

      return (
        <article class="p-4 sm:p-5 rounded-md border border-carbon-700 bg-carbon-850/40 hover:border-carbon-600 transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
            <h2 class="text-base font-semibold text-syntax-text">
              {item.data.title}
            </h2>
            <div class="flex items-center gap-2 text-xs font-mono text-syntax-muted shrink-0">
              <span class={`px-2 py-0.5 rounded text-[11px] font-mono border ${badgeStyle}`}>
                [{item.data.type.toUpperCase()}]
              </span>
              <time datetime={item.data.date.toISOString()}>
                {formattedDate}
              </time>
            </div>
          </div>

          {item.data.status && (
            <p class="text-xs font-mono text-syntax-muted mb-2">
              estado: <span class="text-syntax-text">{item.data.status}</span>
            </p>
          )}

          <div class="prose-garden text-sm text-syntax-muted my-2">
            <Content />
          </div>

          <div class="mt-3 pt-3 border-t border-carbon-700/40 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
            {item.data.tags && item.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {item.data.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-xs rounded bg-carbon-800 text-syntax-subtle border border-carbon-700/50">
                    #{tag}
                  </span>
                ))}
              </div>
            )}

            {item.data.link && (
              <a href={item.data.link} target="_blank" rel="noopener noreferrer" class="text-syntax-accent hover:underline">
                enlace al proyecto &rarr;
              </a>
            )}
          </div>
        </article>
      );
    })}

    {sortedRincon.length === 0 && (
      <div class="p-8 text-center border border-dashed border-carbon-700 rounded-md font-mono text-xs text-syntax-muted">
        [!] No hay entradas en <code>src/content/rincon/</code> aún.
      </div>
    )}
  </div>
</BaseLayout>
