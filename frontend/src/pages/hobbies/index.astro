---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const hobbiesEntries = await getCollection('hobbies');
const sortedHobbies = hobbiesEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Hobbies & Curiosidades" currentPath="/hobbies">
  <section class="mb-10 pb-6 border-b border-carbon-700/60">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs font-mono text-syntax-accent font-semibold">[OFF-DUTY // HOBBIES]</span>
      <span class="text-xs font-mono text-syntax-muted">/root/hobbies</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-syntax-text">
      Coleccionismo, Pokémon y Gaming
    </h1>
    <p class="mt-2 text-sm text-syntax-muted max-w-2xl font-normal leading-relaxed">
      Un rincón para desconectar del código: colecciones de cartas TCG, sesiones de gaming casual, consolas retro, periféricos y curiosidades analógicas.
    </p>
  </section>

  <div class="space-y-4">
    {sortedHobbies.map((item) => {
      const formattedDate = item.data.date.toISOString().split('T')[0];
      return (
        <article class="p-5 rounded-md border border-carbon-700 bg-carbon-850/40 hover:border-carbon-600 transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
            <h2 class="text-base font-semibold text-syntax-text">
              {item.data.title}
            </h2>
            <div class="flex items-center gap-2 text-xs font-mono text-syntax-muted">
              <span class="px-1.5 py-0.5 rounded bg-carbon-800 border border-carbon-700 text-syntax-accent">
                #{item.data.category}
              </span>
              <time datetime={item.data.date.toISOString()}>
                {formattedDate}
              </time>
            </div>
          </div>

          {item.data.status && (
            <p class="text-xs font-mono text-syntax-muted mt-1">
              estado: <span class="text-syntax-text">{item.data.status}</span>
            </p>
          )}

          {item.data.tags && item.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {item.data.tags.map((tag) => (
                <span class="px-2 py-0.5 text-xs font-mono rounded bg-carbon-800/80 text-syntax-subtle border border-carbon-700/50">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      );
    })}

    {sortedHobbies.length === 0 && (
      <div class="p-8 text-center border border-dashed border-carbon-700 rounded-md font-mono text-xs text-syntax-muted">
        [!] No hay notas de hobbies registradas en <code>src/content/hobbies/</code> aún.
      </div>
    )}
  </div>
</BaseLayout>

