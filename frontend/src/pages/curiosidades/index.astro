---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const curiosidadesEntries = await getCollection('curiosidades');
const sortedCuriosidades = curiosidadesEntries.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="Curiosidades" currentPath="/curiosidades">
  <section class="mb-8 pb-5 border-b border-carbon-700/60">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs font-mono text-syntax-warning font-semibold">[CURIOSIDADES // ASOMBROS]</span>
      <span class="text-xs font-mono text-syntax-muted">/root/curiosidades</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-syntax-text">
      Hechos insólitos y ciencia asombrosa
    </h1>
    <p class="mt-2 text-sm text-syntax-muted max-w-2xl font-normal leading-relaxed">
      Dinosaurios, fenómenos naturales, paradojas de la física, rarezas del reino animal y pequeñas historias que desafían el sentido común.
    </p>
  </section>

  <div class="space-y-6">
    {sortedCuriosidades.map(async (entry) => {
      const { Content } = await entry.render();
      const formattedDate = entry.data.publishDate.toISOString().split('T')[0];
      return (
        <article class="p-4 sm:p-5 rounded-md border border-carbon-700 bg-carbon-850/60 hover:border-carbon-600 transition-colors">
          <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 pb-3 border-b border-carbon-700/40">
            <h2 class="text-base font-semibold text-syntax-text">
              {entry.data.title}
            </h2>
            <div class="flex items-center gap-3 text-xs font-mono text-syntax-muted">
              <time datetime={entry.data.publishDate.toISOString()}>
                {formattedDate}
              </time>
            </div>
          </header>

          <div class="prose-garden text-sm">
            <Content />
          </div>

          {entry.data.tags && entry.data.tags.length > 0 && (
            <footer class="mt-4 pt-3 flex flex-wrap gap-1.5 border-t border-carbon-700/30">
              {entry.data.tags.map((tag) => (
                <span class="px-2 py-0.5 text-xs font-mono rounded bg-carbon-800 text-syntax-muted border border-carbon-700/50">
                  #{tag}
                </span>
              ))}
            </footer>
          )}
        </article>
      );
    })}

    {sortedCuriosidades.length === 0 && (
      <div class="p-8 text-center border border-dashed border-carbon-700 rounded-md font-mono text-xs text-syntax-muted">
        [!] No hay curiosidades registradas en <code>src/content/curiosidades/</code> aún.
      </div>
    )}
  </div>
</BaseLayout>
